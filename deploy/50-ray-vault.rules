// Let the Ray Vault service run its BLE recovery steps without root. Installed to /etc/polkit-1/rules.d/ by
// deploy/install.sh. Each permission is narrow: one unit, one verb, one user.
polkit.addRule(function (action, subject) {
  if (subject.user != "rayvault") {
    return polkit.Result.NOT_HANDLED;
  }
  if (action.id == "org.freedesktop.systemd1.manage-units") {
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    // restart bluetoothd
    if (unit == "bluetooth.service" && verb == "restart") {
      return polkit.Result.YES;
    }
    // reset the Bluetooth chip (deploy/bt-chip-reset.sh, run as root by this oneshot unit)
    if (unit == "ray-vault-bt-reset.service" && verb == "start") {
      return polkit.Result.YES;
    }
  }
  // last resort, only used when [bms] reboot_after_s is set: reboot the Pi
  if (action.id == "org.freedesktop.login1.reboot" || action.id == "org.freedesktop.login1.reboot-multiple-sessions") {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
